# Banco (MySQL 8, ex.: Aiven), obrigatório: o mesmo para todas as máquinas.
SHARED_DB_HOST=
SHARED_DB_PORT=3306
SHARED_DB_USER=
SHARED_DB_PASSWORD=
SHARED_DB_NAME=
SHARED_DB_SSL_CA=.shared-db-ca.pem
# 32 bytes em base64 (ex.: `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`).
TOTP_ENCRYPTION_KEY=

# Opcional: liga o banco no Aiven 30 min antes de cada horário das Recorrências agendadas.
AIVEN_API_TOKEN=
AIVEN_PROJECT=
AIVEN_SERVICE=

# Opcional: conectores (app OAuth de cada serviço).
MONDAY_CLIENT_ID=
MONDAY_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# O Slack pode exigir HTTPS no redirect: aponte para um túnel até http://localhost:15173.
SLACK_REDIRECT_URI=

# Opcional: grupo do WhatsApp que recebe as Recorrências (JID, ex.: 1203...@g.us).
WHATSAPP_RECIPIENT_JID=

# Opcional: Ollama local para o resumo dos atendimentos.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:14b
OLLAMA_EMBED_MODEL=nomic-embed-text
